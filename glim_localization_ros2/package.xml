<?xml version="1.0"?>
<package format="3">
  <name>glim_localization_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 interface for glim_localization</description>
  <maintainer email="dandelion1124@gmail.com">atinfinity</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_index_cpp</depend>
  <depend>diagnostic_msgs</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>glim</depend>
  <depend>glim_localization</depend>
  <depend>glim_localization_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <!-- launch/. rviz2 is deliberately not a dependency: the launch files start it only with rviz:=true and skip it
       with a warning when it is not installed (headless machines). -->
  <exec_depend>ament_index_python</exec_depend>
  <!-- glim_ros: the R1 launch file runs its glim_rosnode / glim_rosbag (and the tests use them) -->
  <exec_depend>glim_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>composition_interfaces</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>ros2bag</test_depend>
  <test_depend>rosbag2_storage_default_plugins</test_depend>
  <test_depend>rosbag2_interfaces</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
